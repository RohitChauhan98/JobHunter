# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://jobhunter:choose-a-strong-password@localhost:5432/jobhunter"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# ─── AI Providers (users add their own keys via dashboard) ───
# These are optional server-level defaults / fallbacks
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# ─── Local LLM ──────────────────────────────────────────────
# URL of a local LLM server (e.g. Ollama, LM Studio, vLLM)
LOCAL_LLM_URL="http://localhost:11434"
LOCAL_LLM_MODEL="llama3"

# ─── Razorpay ───────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys (use test keys for local)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Optional — required only if you configure webhooks in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=""
